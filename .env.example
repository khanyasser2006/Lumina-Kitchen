# ═══════════════════════════════════════════════════════
# LUMINA — Environment Variables
#
# INSTRUCTIONS:
# 1. Copy this file to `.env` (remove the .example suffix)
# 2. Sign up at https://resend.com and create an API key
# 3. Paste your API key and recipient email below
# ═══════════════════════════════════════════════════════

RESEND_API_KEY=            # e.g. re_abc123XYZ...
RECIPIENT_EMAIL=           # e.g. sales@luminakitchens.com
PORT=3001
